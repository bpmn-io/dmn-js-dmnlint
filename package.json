{
  "name": "dmn-js-dmnlint",
  "version": "0.2.0",
  "description": "dmn-js integration for dmnlint",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "source": "lib/index.js",
  "scripts": {
    "all": "run-s lint lint:theme test distro",
    "lint": "eslint .",
    "lint:theme": "bpmn-io-theme-validate assets/css/dmn-js-drd-dmnlint.css",
    "start": "cross-env SINGLE_START=true npm run dev",
    "test": "karma start --no-auto-test --single-run",
    "dev": "karma start",
    "distro": "run-s bundle test:bundle copy-assets",
    "bundle": "NODE_ENV=production rollup -c",
    "bundle:watch": "NODE_ENV=production rollup -c -w",
    "test:bundle": "echo \"NO TESTS YET\"",
    "copy-assets": "cpx assets/css/* dist/assets/css/ -v",
    "prepublishOnly": "run-s distro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/dmn-js-dmnlint.git"
  },
  "author": "Maciej Barelkowski <https://github.com/barmac>",
  "license": "MIT",
  "devDependencies": {
    "@bpmn-io/theme": "^0.3.0",
    "@rollup/plugin-node-resolve": "^7.1.1",
    "axe-core": "^4.14.0",
    "chai": "^6.3.0",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "dmn-js": "^17.12.3",
    "dmnlint": "^2.0.0",
    "dmnlint-loader": "^0.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-bpmn-io": "^2.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-debug-launcher": "^0.0.5",
    "karma-env-preprocessor": "^0.1.1",
    "karma-mocha": "^2.0.1",
    "karma-webpack": "^5.0.1",
    "mocha": "^11.8.0",
    "mocha-test-container-support": "^0.2.0",
    "npm-run-all2": "^9.0.3",
    "rollup": "^1.17.0",
    "rollup-plugin-string": "^3.0.0",
    "webpack": "^5.111.1"
  },
  "dependencies": {
    "diagram-js": "^15.28.1",
    "min-dash": "^5.1.0",
    "min-dom": "^5.3.0"
  },
  "peerDependencies": {
    "dmnlint": "^2.0.0"
  },
  "overrides": {
    "dmnlint-loader": {
      "dmnlint": "$dmnlint"
    }
  },
  "files": [
    "dist"
  ]
}
